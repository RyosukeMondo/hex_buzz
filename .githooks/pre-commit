#!/bin/bash
# Pre-commit hook for honeycomb-one-pass
# Enforces code quality: formatting, static analysis, LOC limits, and tests

set -e

echo "Running pre-commit checks..."

# Get the project root directory
PROJECT_ROOT="$(git rev-parse --show-toplevel)"
cd "$PROJECT_ROOT"

# Step 1: Check dart format
echo ""
echo "==> Checking dart format..."
if ! dart format --set-exit-if-changed lib test bin scripts 2>/dev/null; then
    echo "✗ Code is not properly formatted."
    echo "  Run 'dart format lib test bin scripts' to fix."
    exit 1
fi
echo "✓ Code formatting OK"

# Step 2: Run dart analyze
echo ""
echo "==> Running dart analyze..."
if ! dart analyze --fatal-infos; then
    echo "✗ Static analysis found issues."
    echo "  Please fix the issues reported above."
    exit 1
fi
echo "✓ Static analysis OK"

# Step 3: Run LOC checks (file and function size, staged files only)
echo ""
echo "==> Checking code metrics (LOC limits)..."
if ! dart run scripts/pre_commit.dart; then
    exit 1
fi

# Step 3b: Web-safety checks on staged files
echo ""
echo "==> Checking web compatibility..."
STAGED_DART=$(git diff --cached --name-only --diff-filter=ACM | grep '\.dart$' || true)
WEB_ERRORS=0
for FILE in $STAGED_DART; do
    # Block dart:io in non-platform/non-debug lib code
    if echo "$FILE" | grep -q "^lib/" \
        && ! echo "$FILE" | grep -q "lib/debug/" \
        && ! echo "$FILE" | grep -q "lib/platform/" \
        && ! echo "$FILE" | grep -q "lib/data/local/file_" \
        && ! echo "$FILE" | grep -q "notification_provider.dart"; then
        if grep -q "import 'dart:io'" "$FILE" 2>/dev/null; then
            echo "  ✗ $FILE imports dart:io (crashes on web)"
            WEB_ERRORS=$((WEB_ERRORS + 1))
        fi
    fi
    # Block direct Firestore in presentation layer
    if echo "$FILE" | grep -q "^lib/presentation/"; then
        if grep -q "FirebaseFirestore.instance" "$FILE" 2>/dev/null; then
            echo "  ✗ $FILE uses FirebaseFirestore.instance directly"
            WEB_ERRORS=$((WEB_ERRORS + 1))
        fi
    fi
done
if [ $WEB_ERRORS -gt 0 ]; then
    echo "✗ $WEB_ERRORS web compatibility issue(s) found."
    exit 1
fi
echo "✓ Web compatibility OK"

# Step 4: Run unit/widget tests (integration tests run separately in CI)
echo ""
echo "==> Running tests..."
STAGED_TEST_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '_test\.dart$' || true)
if [ -n "$STAGED_TEST_FILES" ]; then
    if ! flutter test $STAGED_TEST_FILES; then
        echo "✗ Tests failed."
        exit 1
    fi
    echo "✓ Tests passed"
else
    echo "✓ No test files staged, skipping"
fi

echo ""
echo "================================================"
echo "✓ All pre-commit checks passed!"
echo "================================================"
