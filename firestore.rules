rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the user is the owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function to validate timestamp fields
    function hasValidTimestamp(field) {
      return request.resource.data[field] is timestamp;
    }

    // Users collection - user profiles
    match /users/{userId} {
      // Anyone authenticated can read user profiles
      allow read: if isAuthenticated();

      // Users can only write their own profile
      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && hasValidTimestamp('createdAt')
        && hasValidTimestamp('lastLoginAt');

      allow update: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && hasValidTimestamp('lastLoginAt');

      // Delete not allowed
      allow delete: if false;
    }

    // Leaderboard collection - computed by Cloud Functions
    match /leaderboard/{userId} {
      // Anyone authenticated can read the leaderboard
      allow read: if isAuthenticated();

      // Only Cloud Functions can write to leaderboard
      // (Cloud Functions run with admin privileges, bypassing these rules)
      allow write: if false;
    }

    // Daily challenges collection
    match /dailyChallenges/{dateId} {
      // Anyone authenticated can read daily challenges
      allow read: if isAuthenticated();

      // Only Cloud Functions can write daily challenges
      allow write: if false;

      // Daily challenge entries subcollection
      match /entries/{userId} {
        // Anyone authenticated can read all entries (for leaderboard display)
        allow read: if isAuthenticated();

        // Users can create their own entry only if:
        // 1. User is authenticated
        // 2. userId in path matches auth.uid
        // 3. No existing document exists (enforced by checking resource == null)
        // This prevents duplicate completions for the same user+date
        allow create: if isAuthenticated()
          && userId == request.auth.uid
          && !exists(/databases/$(database)/documents/dailyChallenges/$(dateId)/entries/$(userId))
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.stars is int
          && request.resource.data.stars >= 0
          && request.resource.data.stars <= 3
          && request.resource.data.completionTime is int
          && request.resource.data.completionTime > 1000
          && hasValidTimestamp('completedAt');

        // Prevent updates and deletes to ensure completion integrity
        allow update, delete: if false;
      }
    }

    // Score submissions collection - write-only, triggers Cloud Functions
    match /scoreSubmissions/{submissionId} {
      // No one can read score submissions (they're just a trigger)
      allow read: if false;

      // Users can only submit their own scores
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.stars is int
        && request.resource.data.stars >= 0
        && request.resource.data.stars <= 3
        && request.resource.data.time is int
        && request.resource.data.time > 0
        && request.resource.data.totalStars is int
        && request.resource.data.totalStars >= 0
        && hasValidTimestamp('submittedAt');

      // Update and delete not allowed
      allow update, delete: if false;
    }

    // Friends collection - friend relations per user
    match /friends/{userId} {
      // Allow read of the parent document if needed
      allow read: if isOwner(userId);
      allow write: if false;

      // Friend relations subcollection
      match /relations/{friendId} {
        // Only the document owner can read their own friend relations
        allow read: if isOwner(userId);

        // Owner can create friend relations
        allow create: if isOwner(userId)
          && request.resource.data.status is string
          && request.resource.data.initiatedBy is string;

        // Owner can update (accept/reject) friend relations
        allow update: if isOwner(userId)
          && request.resource.data.status is string;

        // Owner can delete friend relations (unfriend)
        allow delete: if isOwner(userId);
      }
    }

    // Achievements collection - per-user achievement records
    match /achievements/{userId} {
      // Anyone authenticated can read achievements (for profile viewing)
      allow read: if isAuthenticated();

      // Only Cloud Functions write achievements
      allow write: if false;

      // Individual achievement documents
      match /{achievementId} {
        // Anyone authenticated can read (for viewing friend achievements)
        allow read: if isAuthenticated();

        // Only Cloud Functions write achievements
        // (onAchievementUnlocked callable runs with admin privileges)
        allow write: if false;
      }
    }

    // Timed challenge scores collection
    match /timedChallengeScores/{configId} {
      // Allow read of the parent document
      allow read: if isAuthenticated();
      allow write: if false;

      // Score entries subcollection
      match /entries/{userId} {
        // Authenticated users can read all entries (for leaderboard)
        allow read: if isAuthenticated();

        // Only Cloud Functions write scores
        // (submitTimedChallengeScore callable runs with admin privileges)
        allow write: if false;
      }
    }

    // Shared levels collection - user-created levels
    match /sharedLevels/{levelId} {
      // Authenticated users can read any shared level
      allow read: if isAuthenticated();

      // Only Cloud Functions write shared levels
      // (publishLevel callable runs with admin privileges)
      allow write: if false;
    }
  }
}
